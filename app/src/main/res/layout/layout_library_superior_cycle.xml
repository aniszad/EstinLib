<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <!-- First Year (CS1) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/manrope_bold"
            android:text="@string/first_year"
            android:textAllCaps="true"
            android:textColor="@color/colorTextGray"
            android:textSize="12sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/colorSecondaryDark"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_1cs_1semester"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:fontFamily="@font/manrope_semi_bold"
                    android:gravity="start|center_vertical"
                    android:paddingHorizontal="16dp"
                    android:text="@string/semester_1"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    app:icon="@drawable/icon_drop_down_arrow"
                    app:iconGravity="end"
                    app:iconTint="@color/white" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_1cs_semester1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="8dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorPrimaryDark" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_1cs_2semester"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:fontFamily="@font/manrope_semi_bold"
                    android:gravity="start|center_vertical"
                    android:paddingHorizontal="16dp"
                    android:text="@string/semester_2"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    app:icon="@drawable/icon_drop_down_arrow"
                    app:iconGravity="end"
                    app:iconTint="@color/white" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_1cs_semester2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="8dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Second Year (CS2) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/manrope_bold"
            android:text="@string/second_year"
            android:textAllCaps="true"
            android:textColor="@color/colorTextGray"
            android:textSize="12sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/colorSecondaryDark"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_2cs_1semester"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:fontFamily="@font/manrope_semi_bold"
                    android:gravity="start|center_vertical"
                    android:paddingHorizontal="16dp"
                    android:text="@string/semester_1"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    app:icon="@drawable/icon_drop_down_arrow"
                    app:iconGravity="end"
                    app:iconTint="@color/white" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_2cs_semester1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="8dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorPrimaryDark" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_2cs_2semester_ai"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:fontFamily="@font/manrope_semi_bold"
                    android:gravity="start|center_vertical"
                    android:paddingHorizontal="16dp"
                    android:text="@string/semester_2_ai_ds"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    app:icon="@drawable/icon_drop_down_arrow"
                    app:iconGravity="end"
                    app:iconTint="@color/white" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_2cs_semester2_ai"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="8dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorPrimaryDark" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_2cs_2semester_cs"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:fontFamily="@font/manrope_semi_bold"
                    android:gravity="start|center_vertical"
                    android:paddingHorizontal="16dp"
                    android:text="@string/semester_2_cs"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    app:icon="@drawable/icon_drop_down_arrow"
                    app:iconGravity="end"
                    app:iconTint="@color/white" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_2cs_semester2_cs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="8dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Third Year (CS3) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/manrope_bold"
            android:text="Third Year"
            android:textAllCaps="true"
            android:textColor="@color/colorTextGray"
            android:textSize="12sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/colorSecondaryDark"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_3cs_1semester_ai"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:fontFamily="@font/manrope_semi_bold"
                    android:gravity="start|center_vertical"
                    android:paddingHorizontal="16dp"
                    android:text="@string/semester_1_ai_ds"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    app:icon="@drawable/icon_drop_down_arrow"
                    app:iconGravity="end"
                    app:iconTint="@color/white" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_3cs_semester1_ai"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="8dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorPrimaryDark" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_3cs_1semester_cs"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:fontFamily="@font/manrope_semi_bold"
                    android:gravity="start|center_vertical"
                    android:paddingHorizontal="16dp"
                    android:text="@string/semester_1_cs"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    app:icon="@drawable/icon_drop_down_arrow"
                    app:iconGravity="end"
                    app:iconTint="@color/white" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_3cs_semester1_cs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="8dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>